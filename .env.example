# Copy this file to .env and fill in your keys.
# cp .env.example .env

# ElevenLabs Scribe — required by video-use for transcription w/ word-level timestamps.
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: OpenAI key (some video-use helpers / Remotion overlays may use it)
# OPENAI_API_KEY=

# Optional: Anthropic key (only if running standalone scripts outside Claude Code)
# ANTHROPIC_API_KEY=
